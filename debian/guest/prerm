#!/bin/sh
set -e

DKMS_NAME=inotify-trigger
DKMS_VERSION=1.0
UNIT=virtiofs-notify-guest.service

if [ "$1" = remove ]; then
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop "$UNIT" >/dev/null || true
    fi
    # Before dkms remove: modprobe can't find the module once its file is gone.
    modprobe -r inotify_trigger 2>/dev/null || true
fi

case "$1" in
remove | upgrade | deconfigure)
    if [ -n "$(dkms status -m "$DKMS_NAME" -v "$DKMS_VERSION")" ]; then
        dkms remove -m "$DKMS_NAME" -v "$DKMS_VERSION" --all
    fi
    ;;
esac
