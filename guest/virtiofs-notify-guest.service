[Unit]
Description=Replay host-side virtiofs changes as inotify events (virtiofs-notify)
After=local-fs.target remote-fs.target

[Service]
ExecStartPre=/usr/sbin/modprobe inotify_trigger
ExecStart=/usr/sbin/virtiofs-notify-guest
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_VSOCK

[Install]
WantedBy=multi-user.target
